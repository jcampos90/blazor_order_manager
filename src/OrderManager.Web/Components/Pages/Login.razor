@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout

<PageTitle>Iniciar sesión</PageTitle>

@if (Error == "invalid")
{
    <div class="alert alert-danger" role="alert">Email o contraseña incorrectos.</div>
}
else if (Error == "missing")
{
    <div class="alert alert-danger" role="alert">Ingresá email y contraseña.</div>
}
else if (Error == "expired")
{
    <div class="alert alert-danger" role="alert">Tu sesión expiró. Volvé a iniciar sesión.</div>
}

<form method="post" action="/api/login">
    <AntiforgeryToken />
    <input name="returnUrl" type="hidden" value="@ReturnUrl" />

    <div class="field" style="margin-bottom: .9rem;">
        <label class="form-label" for="email">Email</label>
        <input id="email" name="email" type="email" class="form-control" required autocomplete="username" />
    </div>

    <div class="field" style="margin-bottom: 1.2rem;">
        <label class="form-label" for="password">Contraseña</label>
        <input id="password" name="password" type="password" class="form-control" required autocomplete="current-password" />
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%;">Entrar</button>
</form>

<p style="text-align:center; color: var(--text-2); font-size: .85rem; margin: 1.4rem 0 0;">
    ¿Necesitás ayuda? Pedile al panadero que te cree un usuario.
</p>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        ReturnUrl ??= "/";
    }
}
