@page "/"
@rendermode InteractiveServer
@inject DashboardService Dashboard

<PageTitle>Hoy — Producción</PageTitle>

<div class="page-header">
    <div>
        <h1>Hoy</h1>
        <p class="page-sub">Qué tenés que poner en marcha para entregar a tiempo.</p>
    </div>
    <div class="page-header-actions">
        <a class="btn btn-primary" href="/encargos/nuevo">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Nuevo encargo
        </a>
    </div>
</div>

@if (_loading)
{
    <div class="card"><div class="card-body">Cargando producción…</div></div>
}
else if (_items.Count == 0)
{
    <div class="card">
        <div class="empty">
            <span class="empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2.5 12.5C2.5 10.8 3.9 9.4 5.6 9.4 5.9 6.4 8.5 4 12 4s6.1 2.4 6.4 5.4c1.7 0 3.1 1.4 3.1 3.1 0 1.8-1.4 3.2-3.2 3.2H5.7c-1.8 0-3.2-1.4-3.2-3.2z" />
                    <path d="M12 4v10" />
                </svg>
            </span>
            <h3>Nada por producir</h3>
            <p>No hay encargos pendientes. Cuando cargues uno, acá vas a ver en qué momento arrancar cada preparación.</p>
            <a class="btn btn-primary" href="/encargos/nuevo">Cargar un encargo</a>
        </div>
    </div>
}
else
{
    <div class="stats">
        <div class="stat @(_overdueCount > 0 ? "stat-danger" : "stat-ok")">
            <span class="stat-label">Atrasados</span>
            <span class="stat-value">@_overdueCount</span>
            <span class="stat-note">@(_overdueCount == 1 ? "renglón pasó su hora límite" : _overdueCount == 0 ? "todo bajo control" : "renglones pasaron su hora límite")</span>
        </div>
        <div class="stat stat-primary">
            <span class="stat-label">Por iniciar hoy</span>
            <span class="stat-value">@_todayCount</span>
            <span class="stat-note">@(_todayCount == 1 ? "preparación arranca hoy" : "preparaciones arrancan hoy")</span>
        </div>
        <div class="stat">
            <span class="stat-label">Entregas hoy</span>
            <span class="stat-value">@_deliveryTodayCount</span>
            <span class="stat-note">@(_deliveryTodayCount == 1 ? "encargo sale hoy" : "encargos salen hoy")</span>
        </div>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Iniciar a más tardar</th>
                    <th>Producto</th>
                    <th class="num">Cant.</th>
                    <th>Cliente</th>
                    <th>Entrega</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    var overdue = item.Overdue(_now);
                    <tr class="@(overdue ? "row-overdue" : "")">
                        <td class="cell-strong">
                            @item.StartBy.ToString("ddd d MMM · HH:mm")
                            @if (overdue)
                            {
                                <span class="badge badge-overdue">Atrasado</span>
                            }
                        </td>
                        <td>@item.ProductName</td>
                        <td class="num">@item.Quantity</td>
                        <td>@item.CustomerName</td>
                        <td class="table-muted">@item.DeliveryAt.ToString("ddd d MMM · HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<PrepItem> _items = [];
    private DateTime _now;
    private int _overdueCount;
    private int _todayCount;
    private int _deliveryTodayCount;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _now = DateTime.Now;
        _items = await Dashboard.GetProductionAsync(_now);
        _overdueCount = _items.Count(i => i.Overdue(_now));
        _todayCount = _items.Count(i => i.StartBy.Date == _now.Date);
        _deliveryTodayCount = _items.Count(i => i.DeliveryAt.Date == _now.Date);
        _loading = false;
    }
}
