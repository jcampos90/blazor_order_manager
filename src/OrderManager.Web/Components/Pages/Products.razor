@page "/productos"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> Factory

<PageTitle>Productos</PageTitle>

<div class="page-header">
    <div>
        <h1>Productos</h1>
        <p class="page-sub">Cada producto define sus horas de preparación: la app calcula cuándo hay que empezar.</p>
    </div>
    <div class="page-header-actions">
        <button class="btn btn-primary" @onclick="New">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Nuevo producto
        </button>
    </div>
</div>

@if (_products.Count == 0)
{
    <div class="card">
        <div class="empty">
            <span class="empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 8.2 12 3 3 8.2v7.6L12 21l9-5.2z" />
                    <path d="M3.3 8.3 12 13.1l8.7-4.8" />
                    <path d="M12 22.1V13.1" />
                </svg>
            </span>
            <h3>Sin productos</h3>
            <p>Creá tu primer producto con su tiempo de preparación.</p>
            <button class="btn btn-primary" @onclick="New">Nuevo producto</button>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th class="num">Precio</th>
                    <th class="num">Horas de prep.</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _products)
                {
                    <tr class="@(p.IsActive ? "" : "row-muted")">
                        <td class="cell-strong">@p.Name</td>
                        <td class="num">@p.Price.ToString("C")</td>
                        <td class="num">@p.PrepHours</td>
                        <td>
                            <span class="badge @(p.IsActive ? "badge-delivered" : "")">@(p.IsActive ? "Activo" : "Inactivo")</span>
                        </td>
                        <td class="row-actions">
                            <button class="btn btn-ghost btn-icon" @onclick="() => Edit(p)" title="Editar @p.Name" aria-label="Editar @p.Name">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                                </svg>
                            </button>
                            <button class="btn btn-ghost btn-icon @(p.IsActive ? "is-on" : "")" @onclick="() => ToggleActiveAsync(p)"
                                    title="@(p.IsActive ? "Desactivar" : "Activar")"
                                    aria-label="@(p.IsActive ? "Desactivar" : "Activar") @p.Name"
                                    role="switch" aria-checked="@(p.IsActive ? "true" : "false")">
                                <svg class="switch" viewBox="0 0 24 24" fill="none" stroke-width="1.8" aria-hidden="true">
                                    <rect class="switch-track" x="2.5" y="6.5" width="19" height="11" rx="5.5" />
                                    <circle class="switch-knob" cx="@(p.IsActive ? 17 : 7)" cy="12" r="3.4" />
                                </svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<Modal Title="@(_form.Id == 0 ? "Nuevo producto" : "Editar producto")" Visible="@_showModal" OnClose="Cancel">
    <EditForm Model="@_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <div class="field">
            <label class="form-label" for="productName">Nombre</label>
            <InputText id="productName" class="form-control" @bind-Value="_form.Name" />
            <ValidationMessage For="() => _form.Name" />
        </div>
        <div class="form-row">
            <div class="c-6">
                <div class="field">
                    <label class="form-label" for="productPrice">Precio</label>
                    <InputNumber id="productPrice" class="form-control" @bind-Value="_form.Price" />
                    <ValidationMessage For="() => _form.Price" />
                </div>
            </div>
            <div class="c-6">
                <div class="field">
                    <label class="form-label" for="productPrep">Horas de preparación</label>
                    <InputNumber id="productPrep" class="form-control" @bind-Value="_form.PrepHours" />
                    <ValidationMessage For="() => _form.PrepHours" />
                </div>
            </div>
        </div>
        <label class="check-row" for="isActive">
            <InputCheckbox id="isActive" class="form-check-input" @bind-Value="_form.IsActive" />
            Activo — se ofrece al crear encargos
        </label>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" @onclick="Cancel">Cancelar</button>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </EditForm>
</Modal>

@code {
    private sealed class ProductForm
    {
        public int Id { get; set; }
        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string Name { get; set; } = "";
        [Range(0.01, 999999, ErrorMessage = "Precio inválido")]
        public decimal Price { get; set; }
        [Range(1, 720, ErrorMessage = "Debe ser al menos 1 hora")]
        public int PrepHours { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private readonly List<Product> _products = [];
    private ProductForm _form = new();
    private bool _showModal;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await Factory.CreateDbContextAsync();
        _products.Clear();
        _products.AddRange(await db.Products.OrderBy(p => p.Name).ToListAsync());
    }

    private void New()
    {
        _form = new ProductForm();
        _showModal = true;
    }

    private void Edit(Product p)
    {
        _form = new ProductForm
        {
            Id = p.Id,
            Name = p.Name,
            Price = p.Price,
            PrepHours = p.PrepHours,
            IsActive = p.IsActive,
        };
        _showModal = true;
    }

    private void Cancel() => _showModal = false;

    private async Task SaveAsync()
    {
        await using var db = await Factory.CreateDbContextAsync();
        var product = await db.Products.FindAsync(_form.Id);
        if (product is null)
        {
            product = new Product { Name = _form.Name.Trim() };
            db.Products.Add(product);
        }
        product.Name = _form.Name.Trim();
        product.Price = _form.Price;
        product.PrepHours = _form.PrepHours;
        product.IsActive = _form.IsActive;
        await db.SaveChangesAsync();
        _showModal = false;
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Product p)
    {
        await using var db = await Factory.CreateDbContextAsync();
        var product = await db.Products.FindAsync(p.Id);
        if (product is not null)
        {
            product.IsActive = !product.IsActive;
            await db.SaveChangesAsync();
        }
        await LoadAsync();
    }
}
