@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Http
@using Microsoft.JSInterop
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS

<div class="shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main">
        <header class="topbar">
            <span class="topbar-date">@_today</span>
            <button type="button" class="btn btn-icon btn-ghost theme-toggle" @onclick="ToggleThemeAsync" aria-label="Cambiar tema" title="Cambiar tema">
                <svg class="icon-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                </svg>
                <svg class="icon-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                </svg>
            </button>
            <div class="topbar-user">
                <span class="topbar-identity">@_identity</span>
                <form method="post" action="/signout">
                    <input name="__RequestVerificationToken" type="hidden" value="@_antiforgeryToken" />
                    <button type="submit" class="btn btn-ghost btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </header>

        <div class="content">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">✕</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string _today = "";
    private string _identity = "";
    private string? _antiforgeryToken;
    private IJSObjectReference? _themeModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive && _themeModule is null)
        {
            _themeModule = await JS.InvokeAsync<IJSObjectReference>("import",
                "./Components/Layout/MainLayout.razor.js");
        }
    }

    private async Task ToggleThemeAsync()
    {
        if (_themeModule is null)
            return;
        await _themeModule.InvokeVoidAsync("toggleTheme");
    }

    protected override async Task OnInitializedAsync()
    {
        _today = DateTime.Today.ToString("dddd, d 'de' MMMM", new System.Globalization.CultureInfo("es-AR")).ToUpper();

        _antiforgeryToken ??= HttpContextAccessor.HttpContext is { } httpContext
            ? Antiforgery.GetAndStoreTokens(httpContext).RequestToken
            : null;

        if (AuthenticationState is null)
            return;

        var state = await AuthenticationState;
        _identity = state.User.FindFirst("name")?.Value
            ?? state.User.FindFirst("email")?.Value
            ?? "Usuario";
    }
}
