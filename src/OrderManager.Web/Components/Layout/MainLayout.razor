@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Http
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<div class="shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main">
        <header class="topbar">
            <span class="topbar-date">@_today</span>
            <div class="topbar-user">
                <span class="topbar-identity">@_identity</span>
                <form method="post" action="/signout">
                    <input name="__RequestVerificationToken" type="hidden" value="@_antiforgeryToken" />
                    <button type="submit" class="btn btn-ghost btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </header>

        <div class="content">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">✕</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string _today = "";
    private string _identity = "";
    private string? _antiforgeryToken;

    protected override async Task OnInitializedAsync()
    {
        _today = DateTime.Today.ToString("dddd, d 'de' MMMM", new System.Globalization.CultureInfo("es-AR")).ToUpper();

        _antiforgeryToken ??= HttpContextAccessor.HttpContext is { } httpContext
            ? Antiforgery.GetAndStoreTokens(httpContext).RequestToken
            : null;

        if (AuthenticationState is null)
            return;

        var state = await AuthenticationState;
        _identity = state.User.FindFirst("name")?.Value
            ?? state.User.FindFirst("email")?.Value
            ?? "Usuario";
    }
}
